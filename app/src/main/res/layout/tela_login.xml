<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/principal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/nome_app"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_titulo"
            android:textColor="@color/primaria"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="40dp"
            android:text="@string/login_subtitulo"
            android:textColor="@color/texto_dica"
            android:textSize="14sp" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragmentEmail"
            android:name="com.hudsom.kotlinceapp.fragment.InputEmailFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragmentSenha"
            android:name="com.hudsom.kotlinceapp.fragment.InputSenhaFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbLembrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_lembrar"
            android:textColor="@color/sobre_fundo"
            android:buttonTint="@color/primaria" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEsqueciSenha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="16dp"
            android:text="@string/login_esqueci_senha"
            android:textColor="@color/texto_link"
            style="@style/Widget.Material3.Button.TextButton" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragmentBtnEntrar"
            android:name="com.hudsom.kotlinceapp.fragment.BotaoFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divisor" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/login_google"
            android:textColor="@color/sobre_fundo"
            android:textSize="16sp"
            app:icon="@drawable/icone_google"
            app:iconGravity="textStart"
            app:iconTint="@null"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIrCadastro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/login_link_cadastro"
            android:textColor="@color/texto_link"
            style="@style/Widget.Material3.Button.TextButton" />

    </LinearLayout>
</ScrollView>
